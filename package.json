{
  "name": "resource-hunt",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts --watch",
    "start": "node --import tsx src/server.ts",
    "play": "node --import tsx src/cli.ts play",
    "bench": "node --import tsx src/cli.ts bench",
    "tournament": "node --import tsx src/cli.ts tournament",
    "inspect": "node --import tsx src/cli.ts inspect",
    "bots": "node --import tsx src/cli.ts bots",
    "test": "node --import tsx --test tests/*.test.ts .github/bot-workflow/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "node scripts/format.mjs --write .",
    "format:check": "node scripts/format.mjs --check .",
    "check": "yarn format:check && yarn structure:check && yarn typecheck && yarn test",
    "build": "node --import tsx src/build.ts",
    "structure:check": "node scripts/check-structure.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.8.3"
  },
  "packageManager": "yarn@4.5.3",
  "engines": {
    "node": ">=23.11.1",
    "yarn": ">=4.5.3"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
